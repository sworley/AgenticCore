# .env-required — Required environment variables for this project
#
# Copy this file to .env-required and uncomment the vars your project needs.
# check-env.sh reads this file at session-open and exits non-zero if any are missing.
#
# One variable name per line. Blank lines and # comments are ignored.
# Do NOT put values here — this file is committed to git.
# Values are injected by direnv, .envrc, or your shell profile.
#
# Common variables to consider:
#
# -- Git integration --
# GIT_HOST          # Base URL of your Git instance (e.g. https://git.example.com)
# GIT_TOKEN        # Project Access Token with api scope
# GIT_PROJECT      # Project path (e.g. group/my-project)
#
# -- MCP server --
# MCP_DOCS_ROOT       # Absolute path to the docs root for mcp-rag-docs
#
# -- CI / deployment --
# CI_REGISTRY         # Container registry URL
# DEPLOY_ENV          # Target environment (e.g. staging, production)
#
# Add project-specific vars below:
