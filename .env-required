# Required environment variables
#
# These variables are only required when using the Git-integrated scripts:
#   - mddocs/scripts/git-sync.sh
#   - mddocs/operations/runbooks/rotate-git-pat.md
#
# Users working locally without Git integration can leave this file as-is.
# check-env.sh will still pass for the tool checks even with these unset.
GIT_HOST=
GIT_TOKEN=
